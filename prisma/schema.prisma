generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model apotek {
  gid      Int                      @id @default(autoincrement())
  namobj   String?                  @db.VarChar(250)
  fcode    String?                  @db.VarChar(50)
  remark   String?                  @db.VarChar(250)
  metadata String?                  @db.VarChar(50)
  srs_id   String?                  @db.VarChar(50)
  wadmkd   String?                  @db.VarChar(50)
  wadmkc   String?                  @db.VarChar(50)
  wadmkk   String?                  @db.VarChar(50)
  geom     Unsupported("geometry")?

  @@index([geom], type: Gist)
}

model katalog_data_2d {
  data_2d_id  String   @id(map: "katalog_data_2d_pk") @db.VarChar(50)
  layer_name  String?  @db.VarChar(50)
  akses       String?  @db.VarChar(50)
  is_editable Boolean?
  wms_url     String?  @db.VarChar(64)
  wfs_url     String?  @db.VarChar(256)
  author      String?  @db.VarChar(50)
  layer_alias String?  @db.VarChar
  users       users?   @relation(fields: [author], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "katalog_data_2d_users_fk")
}

model katalog_data_3d {
  data_3d_id String  @id(map: "katalog_data_3d_pk") @db.VarChar
  author     String? @db.VarChar
  model_name String? @db.VarChar
  akses      String? @db.VarChar
  url        String? @db.VarChar
  latitude   Float?
  longitude  Float?
  heading    Int?
  pitch      Int?
  roll       Int?
  scale      Int?
  tipe_file  String? @db.VarChar
  users      users?  @relation(fields: [author], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "katalog_data_3d_users_fk")
}

model mampang_prapatan {
  gid    Int                      @id @default(autoincrement())
  wadmrw String?                  @db.VarChar(3)
  wadmkd String?                  @db.VarChar(50)
  wadmkc String?                  @db.VarChar(50)
  wadmkk String?                  @db.VarChar(50)
  kdfpum String?                  @db.VarChar(13)
  kdepum String?                  @db.VarChar(10)
  kdcpum String?                  @db.VarChar(6)
  kdpkab String?                  @db.VarChar(4)
  srs_id String?                  @db.VarChar(50)
  luaswh Float?
  geom   Unsupported("geometry")?

  @@index([geom], type: Gist)
}

model users {
  user_id         String            @id(map: "users_pk") @db.VarChar
  email           String            @unique(map: "users_unique") @db.VarChar
  password        String?           @db.VarChar
  is__active      Boolean?          @map("is _active")
  role            String?           @db.VarChar
  name            String?           @db.VarChar
  katalog_data_2d katalog_data_2d[]
  katalog_data_3d katalog_data_3d[]
}
